<robot name="two_branch">
  <link name="base"/><link name="upper"/><link name="forearm"/><link name="tcp"/>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper"/><axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper"/><child link="forearm"/><origin xyz="1 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-1.6" upper="2.4"/>
  </joint>
  <joint name="tip" type="fixed">
    <parent link="forearm"/><child link="tcp"/><origin xyz="1 0 0"/>
  </joint>
</robot>
